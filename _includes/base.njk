<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title ~ " | Noel Codes" }}{% else %}Noel Codes portfolio{% endif %}</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <header>
        <a href="/" class="nav-logo">
            <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="oni-mask-logo">
                <!-- Definitions for gradients and effects -->
                <defs>
                    <!-- Main mask gradient - deep purple to dark -->
                    <linearGradient id="maskGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#4a1a6b" />
                        <stop offset="50%" stop-color="#2d1045" />
                        <stop offset="100%" stop-color="#1a0a2e" />
                    </linearGradient>

                    <!-- Accent gradient - neon green -->
                    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#00ff88" />
                        <stop offset="100%" stop-color="#00cc66" />
                    </linearGradient>

                    <!-- Eye glow gradient -->
                    <linearGradient id="eyeGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00ffaa" />
                        <stop offset="50%" stop-color="#00ff66" />
                        <stop offset="100%" stop-color="#88ffcc" />
                    </linearGradient>

                    <!-- Horn gradient -->
                    <linearGradient id="hornGradient" x1="0%" y1="100%" x2="0%" y2="0%">
                        <stop offset="0%" stop-color="#5a2080" />
                        <stop offset="50%" stop-color="#7a30a0" />
                        <stop offset="100%" stop-color="#00ff88" />
                    </linearGradient>

                    <!-- Metallic panel gradient -->
                    <linearGradient id="panelGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#3d1560" />
                        <stop offset="50%" stop-color="#2a0f45" />
                        <stop offset="100%" stop-color="#1f0a35" />
                    </linearGradient>

                    <!-- Glow filter -->
                    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="3" result="coloredBlur" />
                        <feMerge>
                            <feMergeNode in="coloredBlur" />
                            <feMergeNode in="SourceGraphic" />
                        </feMerge>
                    </filter>

                    <!-- Strong glow for eyes -->
                    <filter id="eyeGlowFilter" x="-100%" y="-100%" width="300%" height="300%">
                        <feGaussianBlur stdDeviation="5" result="coloredBlur" />
                        <feMerge>
                            <feMergeNode in="coloredBlur" />
                            <feMergeNode in="coloredBlur" />
                            <feMergeNode in="SourceGraphic" />
                        </feMerge>
                    </filter>
                </defs>

                <!-- Left Horn - sharp angular oni style -->
                <g>
                    <!-- Horn base/ring -->
                    <ellipse cx="100" cy="165" rx="16" ry="10" fill="#c9a227" stroke="#8b7019" stroke-width="2" />
                    <ellipse cx="100" cy="161" rx="12" ry="6" fill="#0a0515" />
                    <!-- Main horn - sharp tapered -->
                    <path d="M88 155 L45 95 L30 40 L38 38 L60 85 L112 155" fill="url(#hornGradient)" stroke="#4a1a6b" stroke-width="1.5" />
                    <!-- Inner edge for sharpness -->
                    <path d="M50 90 L35 45" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.5" />
                </g>

                <!-- Right Horn - sharp angular oni style -->
                <g>
                    <!-- Horn base/ring -->
                    <ellipse cx="300" cy="165" rx="16" ry="10" fill="#c9a227" stroke="#8b7019" stroke-width="2" />
                    <ellipse cx="300" cy="161" rx="12" ry="6" fill="#0a0515" />
                    <!-- Main horn - sharp tapered -->
                    <path d="M312 155 L355 95 L370 40 L362 38 L340 85 L288 155" fill="url(#hornGradient)" stroke="#4a1a6b" stroke-width="1.5" />
                    <!-- Inner edge for sharpness -->
                    <path d="M350 90 L365 45" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.5" />
                </g>

                <!-- Main Face Shape - angular biomechanical -->
                <path d="M200 90
                    L280 120 L320 180 L330 260 L310 340 L280 400 L240 450 L200 470
                    L160 450 L120 400 L90 340 L70 260 L80 180 L120 120 Z" fill="url(#maskGradient)" stroke="#6b3090" stroke-width="2" />

                <!-- Forehead Armor Plate -->
                <path d="M200 95 L260 115 L280 150 L270 180 L200 170 L130 180 L120 150 L140 115 Z" fill="url(#panelGradient)" stroke="#00ff88" stroke-width="1.5" />

                <!-- Center Forehead Crest -->
                <path d="M200 95 L215 130 L200 165 L185 130 Z" fill="#3d1560" stroke="#00ff88" stroke-width="1" filter="url(#glow)" />
                <circle cx="200" cy="130" r="5" fill="#00ff88" filter="url(#eyeGlowFilter)" />

                <!-- Left Cheek Panel -->
                <path d="M85 200 L130 185 L145 250 L130 320 L95 300 L75 250 Z" fill="url(#panelGradient)" stroke="#6b3090" stroke-width="1.5" />

                <!-- Right Cheek Panel -->
                <path d="M315 200 L270 185 L255 250 L270 320 L305 300 L325 250 Z" fill="url(#panelGradient)" stroke="#6b3090" stroke-width="1.5" />

                <!-- Left Eye Socket - EVA style elongated -->
                <path d="M100 210 L160 195 L180 220 L175 250 L140 265 L105 250 Z" fill="#0a0515" stroke="#4a1a6b" stroke-width="2" />

                <!-- Left Eye - angry slant -->
                <path d="M108 235 L155 215 L172 228 L165 248 L135 255 L112 248 Z" fill="url(#eyeGlow)" filter="url(#eyeGlowFilter)" />
                <!-- Left eye angry brow -->
                <path d="M100 230 L175 205" stroke="#1a0a2e" stroke-width="12" stroke-linecap="round" />
                <path d="M130 232 L160 223 L167 232 L148 242 L132 240 Z" fill="#ffffff" opacity="0.7" />

                <!-- Right Eye Socket - EVA style elongated -->
                <path d="M300 210 L240 195 L220 220 L225 250 L260 265 L295 250 Z" fill="#0a0515" stroke="#4a1a6b" stroke-width="2" />

                <!-- Right Eye - angry slant -->
                <path d="M292 235 L245 215 L228 228 L235 248 L265 255 L288 248 Z" fill="url(#eyeGlow)" filter="url(#eyeGlowFilter)" />
                <!-- Right eye angry brow -->
                <path d="M300 230 L225 205" stroke="#1a0a2e" stroke-width="12" stroke-linecap="round" />
                <path d="M270 232 L240 223 L233 232 L252 242 L268 240 Z" fill="#ffffff" opacity="0.7" />

                <!-- Nose Bridge - angular -->
                <path d="M200 200 L215 270 L200 340 L185 270 Z" fill="url(#panelGradient)" stroke="#6b3090" stroke-width="1" />

                <!-- Upper Jaw Plate -->
                <path d="M120 320 L150 300 L200 290 L250 300 L280 320 L270 360 L200 370 L130 360 Z" fill="url(#panelGradient)" stroke="#6b3090" stroke-width="1.5" />

                <!-- Mouth Armor Cover - solid armored plate -->
                <path d="M135 345 L160 335 L200 330 L240 335 L265 345 L260 385 L200 395 L140 385 Z" fill="url(#panelGradient)" stroke="#6b3090" stroke-width="1.5" />

                <!-- Mouth armor detail lines -->
                <path d="M150 355 L200 350 L250 355" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.6" />
                <path d="M155 370 L200 365 L245 370" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.4" />

                <!-- Center mouth vent/grill detail -->
                <path d="M180 352 L180 378" stroke="#00ff88" stroke-width="1.5" opacity="0.5" />
                <path d="M190 350 L190 380" stroke="#00ff88" stroke-width="1.5" opacity="0.5" />
                <path d="M200 349 L200 381" stroke="#00ff88" stroke-width="2" opacity="0.6" />
                <path d="M210 350 L210 380" stroke="#00ff88" stroke-width="1.5" opacity="0.5" />
                <path d="M220 352 L220 378" stroke="#00ff88" stroke-width="1.5" opacity="0.5" />

                <!-- Lower Jaw -->
                <path d="M130 380 L150 390 L200 400 L250 390 L270 380 L260 430 L200 450 L140 430 Z" fill="url(#maskGradient)" stroke="#6b3090" stroke-width="1.5" />

                <!-- Jaw Detail Lines -->
                <path d="M145 400 L165 410 L200 415 L235 410 L255 400" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.6" />

                <!-- Tech Lines - Left Side -->
                <path d="M85 260 L75 280 L80 310" fill="none" stroke="#00ff88" stroke-width="1.5" filter="url(#glow)" />
                <path d="M90 275 L100 290 L95 320" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.7" />

                <!-- Tech Lines - Right Side -->
                <path d="M315 260 L325 280 L320 310" fill="none" stroke="#00ff88" stroke-width="1.5" filter="url(#glow)" />
                <path d="M310 275 L300 290 L305 320" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.7" />

                <!-- Accent Dots/Nodes -->
                <circle cx="100" cy="320" r="4" fill="#00ff88" filter="url(#glow)" />
                <circle cx="300" cy="320" r="4" fill="#00ff88" filter="url(#glow)" />
                <circle cx="120" cy="380" r="3" fill="#00ff88" filter="url(#glow)" />
                <circle cx="280" cy="380" r="3" fill="#00ff88" filter="url(#glow)" />

                <!-- Side Vent Lines - Left -->
                <path d="M80 340 L95 335" stroke="#00ff88" stroke-width="2" />
                <path d="M82 350 L97 345" stroke="#00ff88" stroke-width="2" />
                <path d="M85 360 L100 355" stroke="#00ff88" stroke-width="2" />

                <!-- Side Vent Lines - Right -->
                <path d="M320 340 L305 335" stroke="#00ff88" stroke-width="2" />
                <path d="M318 350 L303 345" stroke="#00ff88" stroke-width="2" />
                <path d="M315 360 L300 355" stroke="#00ff88" stroke-width="2" />
            </svg>
        </a>
        <nav class="navbar" id="nav">
            <button class="hamburger" id="hamburger" aria-label="open navigation menu" title="open navigation menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-menu" id="nav-menu">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/about" class="nav-link">About</a></li>
                <li><a href="/contact" class="nav-link">Contact</a></li>
            </ul>
        </nav>
    </header>
    <main>
    <div class="container">
        {{ content | safe }}
    </div>
    </main>

        <script>
        const hamburger = document.getElementById('hamburger');
        const navMenu = document.getElementById('nav-menu');
        const nav = document.getElementById('nav');

        function updateHamburgerLabel(isOpen) {
            const label = isOpen ? 'close navigation menu' : 'open navigation menu';
            hamburger.setAttribute('aria-label', label);
            hamburger.setAttribute('title', label);
        }

        nav.addEventListener('click', () => {
            const display = window.getComputedStyle(hamburger).display;
            if (display !== "none") {
                const isOpen = !hamburger.classList.contains('active');
                hamburger.classList.toggle('active');
                navMenu.classList.toggle('active');
                updateHamburgerLabel(isOpen);
            }
        });

        // Close menu when a link is clicked
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
                updateHamburgerLabel(false);
            });
        });
        </script>

        <script>
            fetch("../track.js");
        </script>
</body>
</html>