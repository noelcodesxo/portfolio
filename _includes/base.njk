<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Page title #}
    {% set pageTitle = title ~ " | " ~ site.name if title else site.name ~ " — Portfolio" %}
    <title>{{ pageTitle }}</title>

    {# Description: use page description or fall back to site default #}
    {% set pageDescription = description if description else site.description %}
    <meta name="description" content="{{ pageDescription }}">

    {# Author #}
    <meta name="author" content="{{ site.author }}">

    {# Canonical URL #}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    {# Open Graph (Facebook, LinkedIn, etc.) #}
    {% block meta %}
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ site.image }}">
    <meta property="og:site_name" content="{{ site.name }}">

    {# Twitter Card #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.url }}{{ site.image }}">
    {% endblock %}

    {# Theme color for mobile browsers #}
    <meta name="theme-color" id="theme-color" content="#000000">
    <script>
        (() => {
            const root = document.documentElement;
            const themeColor = document.getElementById('theme-color');
            let savedTheme = null;

            try {
                const storedTheme = window.localStorage.getItem('noelcodes-theme');
                if (storedTheme === 'dark' || storedTheme === 'light') {
                    savedTheme = storedTheme;
                    root.dataset.theme = storedTheme;
                }
            } catch {}

            const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
            const activeTheme = savedTheme || (prefersLight ? 'light' : 'dark');
            if (themeColor) {
                themeColor.content = activeTheme === 'light' ? '#ffffff' : '#000000';
            }
        })();
    </script>

    {# Favicon #}
    <link rel="icon" href="/images/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/appletouchicon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Typography: Sora (headings) + Source Sans 3 (body) -->
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/main.css">
</head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JDYYEVBR9T"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-JDYYEVBR9T');
</script>
<body>
    <header>
        <a href="/" class="nav-logo">
            <p>Noel Codes</p>
        </a>
        <nav class="navbar" id="nav">
            <button class="hamburger" id="hamburger" aria-label="open navigation menu" title="open navigation menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <ul class="nav-menu" id="nav-menu">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/blogs" class="nav-link">Blog</a></li>
                <li><a href="/about" class="nav-link">About</a></li>
                <li><a href="/contact" class="nav-link">Contact</a></li>
            </ul>
            <button class="theme-toggle" id="theme-toggle" type="button" role="switch" aria-label="Dark theme" aria-checked="false" hidden>
                <span class="theme-toggle-icon theme-toggle-icon-light" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
                    </svg>
                </span>
                <span class="theme-toggle-icon theme-toggle-icon-dark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M20.3 15.5A8.5 8.5 0 0 1 8.5 3.7 8.5 8.5 0 1 0 20.3 15.5Z"></path>
                    </svg>
                </span>
                <span class="theme-toggle-thumb" aria-hidden="true"></span>
            </button>
        </nav>
    </header>
    <main>
    <div class="container">
        {% block content %}{{ content | safe }}{% endblock %}
    </div>
    </main>

        <script>
        const hamburger = document.getElementById('hamburger');
        const navMenu = document.getElementById('nav-menu');
        const nav = document.getElementById('nav');

        function updateHamburgerLabel(isOpen) {
            const label = isOpen ? 'close navigation menu' : 'open navigation menu';
            hamburger.setAttribute('aria-label', label);
            hamburger.setAttribute('title', label);
        }

        nav.addEventListener('click', () => {
            const display = window.getComputedStyle(hamburger).display;
            if (display !== "none") {
                const isOpen = !hamburger.classList.contains('active');
                hamburger.classList.toggle('active');
                navMenu.classList.toggle('active');
                updateHamburgerLabel(isOpen);
            }
        });

        // Close menu when a link is clicked
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
                updateHamburgerLabel(false);
            });
        });
        </script>

        <script>
            const themeToggle = document.getElementById('theme-toggle');
            const themeRoot = document.documentElement;
            const themeColor = document.getElementById('theme-color');
            const systemThemePreference = window.matchMedia
                ? window.matchMedia('(prefers-color-scheme: light)')
                : null;

            function getActiveTheme() {
                if (themeRoot.dataset.theme === 'dark' || themeRoot.dataset.theme === 'light') {
                    return themeRoot.dataset.theme;
                }
                return systemThemePreference && systemThemePreference.matches ? 'light' : 'dark';
            }

            function updateThemeToggle() {
                const activeTheme = getActiveTheme();
                themeToggle.setAttribute('aria-checked', String(activeTheme === 'dark'));
                if (themeColor) {
                    themeColor.content = activeTheme === 'light' ? '#ffffff' : '#000000';
                }
            }

            themeToggle.addEventListener('click', event => {
                event.stopPropagation();

                const nextTheme = getActiveTheme() === 'dark' ? 'light' : 'dark';
                themeRoot.dataset.theme = nextTheme;

                try {
                    window.localStorage.setItem('noelcodes-theme', nextTheme);
                } catch {}

                updateThemeToggle();
            });

            if (systemThemePreference) {
                const updateForSystemChange = () => {
                    if (!themeRoot.dataset.theme) {
                        updateThemeToggle();
                    }
                };

                if (systemThemePreference.addEventListener) {
                    systemThemePreference.addEventListener('change', updateForSystemChange);
                } else if (systemThemePreference.addListener) {
                    systemThemePreference.addListener(updateForSystemChange);
                }
            }

            updateThemeToggle();
            themeToggle.hidden = false;
        </script>

        <script>
            fetch("/api/track").catch(() => {});
        </script>

        <script>
            document.querySelectorAll('a[href^="http"]').forEach(a => {
                a.setAttribute('target', '_blank');
                a.setAttribute('rel', 'noopener');
            });
        </script>

        <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview">
            <img id="lightbox-img" src="" alt="">
        </div>

        <script>
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img');

            document.querySelectorAll('.content img').forEach(img => {
                img.addEventListener('click', () => {
                    lightboxImg.src = img.src;
                    lightboxImg.alt = img.alt;
                    lightbox.classList.add('open');
                    document.body.style.overflow = 'hidden';
                });
            });

            lightbox.addEventListener('click', () => {
                lightbox.classList.remove('open');
                document.body.style.overflow = '';
            });

            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') {
                    lightbox.classList.remove('open');
                    document.body.style.overflow = '';
                }
            });
        </script>
</body>
</html>
