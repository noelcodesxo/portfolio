{% extends "base.njk" %}

{% block meta %}
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ image if image else site.image }}">
    <meta property="og:site_name" content="{{ site.name }}">

    <meta property="article:author" content="{{ site.author }}">
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    {% for tag in tags %}
        {% if tag != "blog" %}
    <meta property="article:tag" content="{{ tag }}">
        {% endif %}
    {% endfor %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.url }}{{ image if image else site.image }}">
    <meta name="twitter:creator" content="{{ site.twitter }}">
{% endblock %}

{% block content %}<div class="content">{{ content | safe }}</div>{% endblock %}
